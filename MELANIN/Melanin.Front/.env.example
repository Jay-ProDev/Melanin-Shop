# === Adresse de l'API appelée par le front ===

# --- Option 1 : HTTP (dev local rapide) ---
# API lancée avec : dotnet run/F5
 VITE_API_URL=http://localhost:5077/api

# --- Option 2 : Docker ---
# API lancée avec : docker compose -f docker-compose.sqlserver.yml up (ou le compose Azure)
# VITE_API_URL=http://localhost:8080/api