# ============================================================
#  MELANIN SHOP — Variables d'environnement (MODÈLE)
# ============================================================


# ------------------------------------------------------------
#  1. ADMIN (compte créé par le seeder)
# ------------------------------------------------------------
MELANIN_ADMIN_PASSWORD=CHANGE_ME

# ⚠️ Si je lance l'API en local SANS Docker (avec "dotnet run")
# Il faut définir la variable admin à la main, sinon l'API peut planter au démarrage.
# Parce que "dotnet run" ne lit PAS automatiquement le .env (seul Docker Compose le lit).
# PowerShell :
#   $env:MELANIN_ADMIN_PASSWORD="****"
#   dotnet run --project Melanin.API
# Git Bash :
#   MELANIN_ADMIN_PASSWORD="****" dotnet run --project Melanin.API


# ------------------------------------------------------------
#  2. AUTHENTIFICATION — JWT
# ------------------------------------------------------------
Token__Key=CHANGE_ME_long_random_secret_key_min_32_chars


# ------------------------------------------------------------
#  3. STRIPE — Paiement 
# ------------------------------------------------------------
Stripe__SecretKey=CHANGE_ME
Stripe__WebhookSecret=CHANGE_ME


# ------------------------------------------------------------
#  4. MAILER
# ------------------------------------------------------------
Mailer__Password=CHANGE_ME


# ------------------------------------------------------------
#  5. BASE DE DONNÉES — SQL Server local (Docker)
# ------------------------------------------------------------
MSSQL_SA_PASSWORD=CHANGE_ME


# ------------------------------------------------------------
#  6. BASE DE DONNÉES — Azure SQL (production)
# ------------------------------------------------------------
AZURE_SQL_CONNECTION_STRING=Server=tcp:<serveur>.database.windows.net,1433;Initial Catalog=<base>;Persist Security Info=False;User ID=<admin>;Password=<mot_de_passe>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;